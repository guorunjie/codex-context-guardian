{
  "name": "codex-relay-baton-guardian",
  "version": "1.1.1",
  "description": "Sleep-safe Codex recovery: queue audited handoff bundles for long tasks stuck on compact failures or context-window overflow.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/guorunjie/codex-relay-baton-guardian.git"
  },
  "homepage": "https://github.com/guorunjie/codex-relay-baton-guardian#readme",
  "bugs": {
    "url": "https://github.com/guorunjie/codex-relay-baton-guardian/issues"
  },
  "bin": {
    "relay-baton": "bin/relay-baton.js",
    "guardian": "bin/guardian.js",
    "codex-context-guardian": "bin/guardian.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "node --test",
    "doctor": "node ./bin/relay-baton.js doctor",
    "release:check": "node ./bin/relay-baton.js release check",
    "publish:dry-run": "node ./scripts/publish-dry-run.mjs",
    "watch": "node ./bin/relay-baton.js watch",
    "recover:dry": "node ./bin/relay-baton.js recover --last --dry-run"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "scripts/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "keywords": [
    "codex",
    "relay",
    "handoff",
    "context-compaction",
    "context-window",
    "long-running-tasks",
    "ai-agents",
    "recovery",
    "developer-tools",
    "desktop-automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
